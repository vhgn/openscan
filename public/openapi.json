{
  "openapi": "3.1.0",
  "info": {
    "title": "openscan API",
    "version": "1.0.0",
    "description": "REST API of openscan. Authenticated routes use the `openscan_session` cookie set by \"Sign in with GitHub\". Generated by `npm run generate` from src/lib/api/contract.ts; do not edit by hand."
  },
  "servers": [
    {
      "url": "/",
      "description": "This deployment"
    }
  ],
  "tags": [
    {
      "name": "Scans",
      "description": "Security briefs and repository reads"
    },
    {
      "name": "GitHub",
      "description": "GitHub App integration"
    },
    {
      "name": "Auth",
      "description": "Sign-in and sessions (browser redirects)"
    },
    {
      "name": "Agent",
      "description": "Read-only, plain-text API for Codex Cloud tasks during a scan"
    }
  ],
  "paths": {
    "/api/scans": {
      "get": {
        "operationId": "getApiScans",
        "summary": "List your scans",
        "description": "Product scans (each with its repository scans) and the flat list of repository scans (security briefs and repository reads), newest first.",
        "tags": [
          "Scans"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "200": {
            "description": "Scans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanList"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApiScans",
        "summary": "Start a scan",
        "description": "Reviews a whole product (`productId`), or one repository inside its product: any public GitHub repository by `repo` (\"owner/name\" or a github.com URL), or a linked one by `repoId`; `kind: understand` re-reads it instead. Scans run in the background: poll `GET /api/scans/{scanId}`.",
        "tags": [
          "Scans"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartScanRequest"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Queued (or the already running scan of that repository)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartScanResponse"
                }
              }
            }
          },
          "400": {
            "description": "invalid_body, or invalid_repo when `repo` is not a GitHub repository",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "product_not_found, repo_not_found (not linked, or no such public repository) or repo_private",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "product_has_no_repositories, or scan_not_started",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "github_unavailable: GitHub could not be reached to look the repository up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/scans/{scanId}": {
      "get": {
        "operationId": "getApiScansScanId",
        "summary": "Get a scan",
        "description": "Status, phase, progress, event log and, once completed, the brief: summary, findings and questions.",
        "tags": [
          "Scans"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "scanId",
            "in": "path",
            "required": true,
            "description": "Scan id",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The scan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScanDetail"
                }
              }
            }
          },
          "401": {
            "description": "No valid session cookie",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "not_found: no such scan for this user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/github/webhook": {
      "post": {
        "operationId": "postApiGithubWebhook",
        "summary": "GitHub App webhook",
        "description": "Receives `installation`, `installation_repositories` and `push` events. The raw body must be signed with `GITHUB_WEBHOOK_SECRET` (HMAC-SHA256, `X-Hub-Signature-256`). Pushes to the default branch start a review for every user watching the repository.",
        "tags": [
          "GitHub"
        ],
        "security": [
          {
            "webhookSignature": []
          }
        ],
        "parameters": [
          {
            "name": "X-Hub-Signature-256",
            "in": "header",
            "required": true,
            "description": "`sha256=` + hex HMAC-SHA256 of the raw body",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-GitHub-Event",
            "in": "header",
            "required": true,
            "description": "installation, installation_repositories or push",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {},
                "additionalProperties": {},
                "description": "GitHub webhook payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Processed (or ignored)"
          },
          "401": {
            "description": "bad signature"
          }
        }
      }
    },
    "/api/github/setup": {
      "get": {
        "operationId": "getApiGithubSetup",
        "summary": "GitHub App Setup URL",
        "description": "GitHub redirects here after the app is installed or its repository access changes. Resyncs repositories, then redirects into the app.",
        "tags": [
          "GitHub"
        ],
        "security": [
          {
            "session": []
          }
        ],
        "responses": {
          "302": {
            "description": "To the repositories step, or to sign-in without a session",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/github/login": {
      "get": {
        "operationId": "getApiAuthGithubLogin",
        "summary": "Sign in with GitHub",
        "tags": [
          "Auth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "next",
            "in": "query",
            "required": false,
            "description": "Same-site path to return to after signing in",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "To GitHub's authorization page (or to `next` when already signed in)",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/github/callback": {
      "get": {
        "operationId": "getApiAuthGithubCallback",
        "summary": "GitHub OAuth callback",
        "description": "Exchanges the code, upserts the user, syncs repositories and sets the `openscan_session` cookie.",
        "tags": [
          "Auth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "code",
            "in": "query",
            "required": true,
            "description": "Set by GitHub",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": true,
            "description": "Must match the state cookie",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in: to `next` or the landing path",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "Invalid OAuth state"
          }
        }
      }
    },
    "/api/auth/logout": {
      "get": {
        "operationId": "getApiAuthLogout",
        "summary": "Sign out",
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "302": {
            "description": "Session cleared, to /",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "postApiAuthLogout",
        "summary": "Sign out",
        "tags": [
          "Auth"
        ],
        "security": [],
        "responses": {
          "302": {
            "description": "Session cleared, to /",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/dev/login": {
      "get": {
        "operationId": "getApiDevLogin",
        "summary": "Demo sign-in (development only)",
        "description": "Only when `DEV_DEMO_LOGIN=1` (404 otherwise). Signs in a demo user and links the given public repositories.",
        "tags": [
          "Auth"
        ],
        "security": [],
        "parameters": [
          {
            "name": "repos",
            "in": "query",
            "required": false,
            "description": "Comma-separated owner/name list (default OWASP/NodeGoat,juice-shop/juice-shop)",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "next",
            "in": "query",
            "required": false,
            "description": "Path to land on",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Signed in",
            "headers": {
              "Location": {
                "description": "Redirect target",
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Demo login disabled"
          }
        }
      }
    },
    "/api/agent/ping": {
      "get": {
        "operationId": "getApiAgentPing",
        "summary": "Agent: check reachability",
        "description": "For Codex Cloud tasks: confirms openscan is reachable from the task environment. Plain text.",
        "tags": [
          "Agent"
        ],
        "security": [
          {
            "agentToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "ok",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked token (or its scan is no longer running)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/memory": {
      "get": {
        "operationId": "getApiAgentMemory",
        "summary": "Agent: product memory index",
        "description": "For Codex Cloud tasks: what the product's memory holds for this repository, with links to each view. Plain text, readable straight from `curl`.",
        "tags": [
          "Agent"
        ],
        "security": [
          {
            "agentToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Index",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked token (or its scan is no longer running)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "This token has no memory access",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/agent/memory/{view}": {
      "get": {
        "operationId": "getApiAgentMemoryView",
        "summary": "Agent: one memory view",
        "description": "facts: known facts about the product. verdicts: this repository’s earlier verdicts. reviewed: files already reviewed. repos: the other repositories of the product. Plain text.",
        "tags": [
          "Agent"
        ],
        "security": [
          {
            "agentToken": []
          }
        ],
        "parameters": [
          {
            "name": "view",
            "in": "path",
            "required": true,
            "description": "facts, verdicts, reviewed or repos",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "facts, verdicts: search text",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "file",
            "in": "query",
            "required": false,
            "description": "verdicts: only this file",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "reviewed: only this path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The view",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired or revoked token (or its scan is no longer running)",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "403": {
            "description": "This token has no memory access",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Unknown view",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "session": {
        "type": "apiKey",
        "in": "cookie",
        "name": "openscan_session",
        "description": "Set by /api/auth/github/callback"
      },
      "webhookSignature": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Hub-Signature-256",
        "description": "HMAC-SHA256 of the raw body with GITHUB_WEBHOOK_SECRET"
      },
      "agentToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Short-lived token openscan gives a Codex Cloud task for the duration of its scan"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "description": "Machine-readable code, e.g. unauthenticated, invalid_body, repo_not_found"
          },
          "message": {
            "description": "Human-readable explanation",
            "type": "string"
          },
          "issues": {
            "description": "Validation issues (invalid_body only)",
            "type": "array",
            "items": {}
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Finding": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "scan_id": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "critical",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "category": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "file": {
            "type": [
              "string",
              "null"
            ]
          },
          "line": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "description": {
            "type": "string"
          },
          "impact": {
            "type": [
              "string",
              "null"
            ]
          },
          "recommendation": {
            "type": [
              "string",
              "null"
            ]
          },
          "poc": {
            "description": "Proof of concept, when depth is deep_poc",
            "type": [
              "string",
              "null"
            ]
          },
          "confidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "dismissed",
              "fixed"
            ]
          },
          "verdict": {
            "description": "Validator verdict, e.g. confirmed",
            "type": [
              "string",
              "null"
            ]
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Product areas (auth, payments, …)"
          },
          "created_at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Unix time in milliseconds"
          }
        },
        "required": [
          "id",
          "scan_id",
          "repo",
          "severity",
          "category",
          "title",
          "file",
          "line",
          "description",
          "impact",
          "recommendation",
          "poc",
          "confidence",
          "status",
          "verdict",
          "areas",
          "created_at"
        ],
        "additionalProperties": {}
      },
      "ProductScan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product": {
            "type": "string",
            "description": "Product name"
          },
          "trigger": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "completed",
              "failed"
            ],
            "description": "Derived from its repository scans"
          },
          "progress": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "created_at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Unix time in milliseconds"
          },
          "finished_at": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991,
                "description": "Unix time in milliseconds"
              },
              {
                "type": "null"
              }
            ]
          },
          "risk": {
            "description": "Worst risk across its repository scans",
            "type": [
              "string",
              "null"
            ]
          },
          "findings": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "push": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "repo": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "commit_sha": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                },
                "required": [
                  "repo",
                  "commit_sha"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ],
            "description": "Set when a push started it"
          },
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanListItem"
            }
          }
        },
        "required": [
          "id",
          "product_id",
          "product",
          "trigger",
          "status",
          "progress",
          "created_at",
          "finished_at",
          "risk",
          "findings",
          "push",
          "scans"
        ],
        "additionalProperties": false
      },
      "Question": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "rationale": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "open",
              "auto_answered",
              "answered",
              "dismissed"
            ]
          },
          "answer": {
            "type": [
              "string",
              "null"
            ]
          },
          "answer_source": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence": {
            "type": [
              "string",
              "null"
            ]
          },
          "created_at": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991,
            "description": "Unix time in milliseconds"
          }
        },
        "required": [
          "id",
          "question",
          "rationale",
          "status",
          "answer",
          "answer_source",
          "evidence",
          "created_at"
        ],
        "additionalProperties": {}
      },
      "ScanDetail": {
        "type": "object",
        "properties": {
          "scan": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "repo_id": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "kind": {
                "type": "string",
                "enum": [
                  "understand",
                  "security"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "queued",
                  "running",
                  "completed",
                  "failed"
                ]
              },
              "phase": {
                "type": "string"
              },
              "progress": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "error": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "summary": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "riskLevel": {
                        "type": "string",
                        "enum": [
                          "critical",
                          "high",
                          "medium",
                          "low",
                          "info"
                        ]
                      },
                      "headline": {
                        "type": "string"
                      }
                    },
                    "additionalProperties": {}
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The brief: risk, headline, what matters, next actions (completed security scans)"
